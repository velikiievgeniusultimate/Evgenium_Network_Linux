[Unit]
Description=Evgenium isolated StarFive Estonia WireGuard link
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=3
ConditionPathExists=!/var/lib/evgenium-link/resource-hold
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/evgenium-link/link.sh start
ExecStop=/opt/evgenium-link/link.sh stop
TimeoutStartSec=30
TimeoutStopSec=30
[Install]
WantedBy=multi-user.target
