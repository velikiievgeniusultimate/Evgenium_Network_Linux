[Unit]
Description=Evgenium Windows authenticated WG carriers (Reality TCP/XHTTP)
After=network-online.target evgenium-wireguard-ingress.service
Wants=network-online.target
[Service]
DynamicUser=yes
LoadCredential=config.json:/opt/evgenium-windows-ingress/config.json
ExecStart=/opt/evgenium-windows-ingress/xray run -config ${CREDENTIALS_DIRECTORY}/config.json
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=160M
TasksMax=128
LimitNOFILE=4096
[Install]
WantedBy=multi-user.target
