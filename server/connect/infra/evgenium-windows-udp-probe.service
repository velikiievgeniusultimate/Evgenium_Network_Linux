[Unit]
Description=Evgenium bounded UDP diagnostic echo (authenticated clients only)
After=evgenium-wireguard-ingress.service
Requires=evgenium-wireguard-ingress.service
[Service]
ExecStart=/usr/bin/python3 /opt/evgenium-windows-ingress/udp-probe.py
DynamicUser=yes
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET
MemoryMax=32M
CPUQuota=5%
TasksMax=8
[Install]
WantedBy=multi-user.target
