[Unit]
Description=Cloudflare Tunnel for Evgenium owner panel
After=network-online.target evgenium-panel.service evgenium-link.service
Wants=network-online.target evgenium-link.service
[Service]
User=evg-panel-tunnel
Group=evg-panel-tunnel
NetworkNamespacePath=/run/netns/evg-link
BindReadOnlyPaths=/etc/netns/evg-link/resolv.conf:/etc/resolv.conf
LoadCredential=token:/etc/evgenium-panel-tunnel/token
ExecStart=/usr/local/lib/evgenium-panel/cloudflared tunnel --no-autoupdate --protocol http2 --edge-ip-version 4 --metrics 127.0.0.1:9091 run --token-file %d/token
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=256M
CPUQuota=30%
[Install]
WantedBy=multi-user.target
