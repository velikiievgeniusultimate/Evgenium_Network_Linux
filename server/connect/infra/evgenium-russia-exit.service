[Unit]
Description=Evgenium optional Russia egress for authenticated WireGuard devices
After=network-online.target evgenium-wireguard-ingress.service
Requires=evgenium-wireguard-ingress.service

[Service]
DynamicUser=yes
LoadCredential=config.json:/opt/evgenium-connect-infra/russia-exit.json
ExecStartPre=+/usr/bin/python3 /opt/evgenium-connect-infra/ingress.py russia-udp
ExecStart=/opt/evgenium-windows-ingress/xray run -config ${CREDENTIALS_DIRECTORY}/config.json
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
MemoryMax=128M
TasksMax=128
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
