[Unit]
Description=Evgenium separate Hysteria transport experiment
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5
ConditionPathExists=!/var/lib/evgenium-link/resource-hold
[Service]
ExecStart=/opt/evgenium-link/hysteria server -c /etc/evgenium-link/hy.json
Restart=on-failure
RestartSec=15
MemoryMax=192M
CPUQuota=25%
TasksMax=48
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
[Install]
WantedBy=multi-user.target
